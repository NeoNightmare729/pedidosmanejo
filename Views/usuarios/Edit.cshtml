@model PedidosManejo.Models.menu

@{
    ViewBag.Title = "Editar Menú";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-edit"></i> Editar Plato del Menú
                    </h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Edit", "menus", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        @Html.HiddenFor(model => model.MenuID)

                        <div class="row">
                            <!-- Restaurante -->
                            <div class="col-md-12 mb-3">
                                <label for="RestauranteID" class="form-label fw-bold">
                                    <i class="fas fa-utensils"></i> Restaurante
                                </label>
                                @Html.DropDownList("RestauranteID", null, "-- Seleccione un Restaurante --", new { @class = "form-select form-select-lg" })
                                @Html.ValidationMessageFor(model => model.RestauranteID, "", new { @class = "text-danger small" })
                            </div>

                            <!-- Nombre del Plato -->
                            <div class="col-md-12 mb-3">
                                <label for="NombrePlato" class="form-label fw-bold">
                                    <i class="fas fa-drumstick-bite"></i> Nombre del Plato
                                </label>
                                @Html.TextBoxFor(model => model.NombrePlato, new { @class = "form-control form-control-lg", placeholder = "Ej: Pizza Margarita" })
                                @Html.ValidationMessageFor(model => model.NombrePlato, "", new { @class = "text-danger small" })
                            </div>

                            <!-- Descripción -->
                            <div class="col-md-12 mb-3">
                                <label for="Descripcion" class="form-label fw-bold">
                                    <i class="fas fa-align-left"></i> Descripción
                                </label>
                                @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = "4", placeholder = "Describe los ingredientes y características del plato..." })
                                @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger small" })
                            </div>

                            <!-- Precio -->
                            <div class="col-md-6 mb-3">
                                <label for="Precio" class="form-label fw-bold">
                                    <i class="fas fa-dollar-sign"></i> Precio
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">$</span>
                                    @Html.TextBoxFor(model => model.Precio, new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                                </div>
                                @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger small" })
                            </div>

                            <!-- Estado -->
                            <div class="col-md-6 mb-3">
                                <label for="Estado" class="form-label fw-bold">
                                    <i class="fas fa-toggle-on"></i> Estado
                                </label>
                                @Html.DropDownListFor(model => model.Estado,
                                    new SelectList(new[] {
                                        new { Value = "Disponible", Text = "Disponible" },
                                        new { Value = "No Disponible", Text = "No Disponible" }
                                    }, "Value", "Text", Model.Estado),
                                    new { @class = "form-select form-select-lg" })
                                @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger small" })
                            </div>

                            <!-- Imagen Actual -->
                            @if (Model.Imagen != null && Model.Imagen.Length > 0)
                            {
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-image"></i> Imagen Actual
                                    </label>
                                    <div class="text-center p-3 bg-light rounded">
                                        <img src="@String.Format("data:image/jpeg;base64,{0}", Convert.ToBase64String(Model.Imagen))"
                                             alt="@Model.NombrePlato"
                                             class="img-thumbnail"
                                             style="max-height: 250px; object-fit: cover;" />
                                    </div>
                                </div>
                            }

                            <!-- Subir Nueva Imagen -->
                            <div class="col-md-12 mb-4">
                                <label for="imagenArchivo" class="form-label fw-bold">
                                    <i class="fas fa-cloud-upload-alt"></i> Cambiar Imagen (Opcional)
                                </label>
                                <input type="file"
                                       name="imagenArchivo"
                                       id="imagenArchivo"
                                       class="form-control form-control-lg"
                                       accept="image/*" />
                                <small class="text-muted">
                                    <i class="fas fa-info-circle"></i> Formatos permitidos: JPG, PNG, GIF. Si no selecciona una imagen, se mantendrá la actual.
                                </small>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-save"></i> Guardar Cambios
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // Preview de imagen antes de subir
        document.getElementById('imagenArchivo').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function(event) {
                    var preview = document.querySelector('.img-thumbnail');
                    if (preview) {
                        preview.src = event.target.result;
                    }
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}

<style>
    .card {
        border-radius: 15px;
        border: none;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
        padding: 1.5rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }

    .btn-lg {
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
    }

    .form-label {
        margin-bottom: 0.5rem;
        color: #495057;
    }

    .input-group-text {
        background-color: #e9ecef;
        font-weight: bold;
    }
</style>