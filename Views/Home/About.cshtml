@{
    ViewBag.Title = "Sobre Nosotros - El Rincón";
}
<link href="~/Content/css/about.css" rel="stylesheet" />

<!-- =========================== -->
<!-- HERO SOBRE NOSOTROS -->
<!-- =========================== -->
<header class="about-hero bg-dark text-white text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Nuestra Historia</h1>
        <p class="lead fs-4 mb-4">
            Conectando sabores auténticos con tu mesa desde 2018
        </p>
        <div class="hero-stats row justify-content-center mt-5">
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3 class="stat-number text-warning">2</h3>
                    <p class="stat-label">Restaurantes</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3 class="stat-number text-warning">5K+</h3>
                    <p class="stat-label">Clientes Felices</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3 class="stat-number text-warning">15min</h3>
                    <p class="stat-label">Tiempo Promedio</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3 class="stat-number text-warning">50+</h3>
                    <p class="stat-label">Platillos Únicos</p>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- =========================== -->
<!-- NUESTRA HISTORIA -->
<!-- =========================== -->
<section class="container my-5 py-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h2 class="display-5 fw-bold text-danger mb-4">De Pequeña Cocina a Cadena Familiar</h2>
            <p class="lead text-muted mb-4">
                Todo comenzó en 2018 con un pequeño local familiar en el corazón de la ciudad.
                Nuestra pasión por la comida casera y el servicio excepcional nos llevó a expandirnos
                hasta convertirnos en la cadena de dos restaurantes que somos hoy.
            </p>
            <p class="text-muted">
                Mantenemos nuestra esencia: ingredientes frescos, recetas tradicionales y
                ese toque especial que hace que cada plato sea una experiencia memorable.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="about-image-placeholder">
                <div class="image-grid">
                    <div class="grid-item primary"></div>
                    <div class="grid-item secondary"></div>
                    <div class="grid-item tertiary"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================== -->
<!-- NUESTRA MISIÓN -->
<!-- =========================== -->
<section class="bg-light py-5">
    <div class="container my-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-warning mb-3">Lo Que Nos Define</h2>
            <p class="text-muted fs-5">Los pilares que guían cada uno de nuestros platillos</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg rounded-3 hover-lift">
                    <div class="card-body text-center p-4">
                        <div class="mission-icon mb-3">
                            <i class="bi bi-heart-fill"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Pasión por la Calidad</h5>
                        <p class="card-text text-muted">
                            Seleccionamos cuidadosamente cada ingrediente para garantizar
                            frescura y sabor en cada bocado.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg rounded-3 hover-lift">
                    <div class="card-body text-center p-4">
                        <div class="mission-icon mb-3">
                            <i class="bi bi-lightning-fill"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Velocidad con Calidad</h5>
                        <p class="card-text text-muted">
                            Optimizamos nuestros procesos para entregar comida deliciosa
                            en tiempo récord sin comprometer la calidad.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg rounded-3 hover-lift">
                    <div class="card-body text-center p-4">
                        <div class="mission-icon mb-3">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Servicio Personalizado</h5>
                        <p class="card-text text-muted">
                            Cada cliente es especial para nosotros. Nos esforzamos por
                            superar expectativas en cada pedido.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================== -->
<!-- NUESTROS RESTAURANTES -->
<!-- =========================== -->
<section class="container my-5 py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-danger mb-3">Nuestros Restaurantes</h2>
        <p class="text-muted fs-5">Dos ubicaciones, misma calidad excepcional</p>
    </div>

    <div class="row g-5">
        <div class="col-md-6">
            <div class="restaurant-card card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-geo-alt-fill"></i> El Rincón Centro
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="card-text mb-3">
                        <i class="bi bi-clock text-danger"></i>
                        <strong>Horario:</strong> 7:00 AM - 11:00 PM
                    </p>
                    <p class="card-text mb-3">
                        <i class="bi bi-telephone text-danger"></i>
                        <strong>Teléfono:</strong> (123) 456-7890
                    </p>
                    <p class="card-text mb-0">
                        <i class="bi bi-geo text-danger"></i>
                        <strong>Dirección:</strong> Av. Principal #123, Centro
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="restaurant-card card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-geo-alt-fill"></i> El Rincón Norte
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="card-text mb-3">
                        <i class="bi bi-clock text-warning"></i>
                        <strong>Horario:</strong> 8:00 AM - 10:00 PM
                    </p>
                    <p class="card-text mb-3">
                        <i class="bi bi-telephone text-warning"></i>
                        <strong>Teléfono:</strong> (123) 456-7891
                    </p>
                    <p class="card-text mb-0">
                        <i class="bi bi-geo text-warning"></i>
                        <strong>Dirección:</strong> Zona Norte #456, Residencial
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================== -->
<!-- PROCESO DE SERVICIO -->
<!-- =========================== -->
<section class="bg-light py-5">
    <div class="container my-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-warning mb-3">Cómo Funcionamos</h2>
            <p class="text-muted fs-5">Del pedido a tu mesa en simples pasos</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="process-step text-center">
                    <div class="step-number">1</div>
                    <h5 class="fw-bold mt-3">Realizas tu Pedido</h5>
                    <p class="text-muted">Elige entre nuestra variedad de platillos desde nuestra plataforma</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="process-step text-center">
                    <div class="step-number">2</div>
                    <h5 class="fw-bold mt-3">Preparamos con Amor</h5>
                    <p class="text-muted">Nuestros chefs cocinan tu pedido con ingredientes frescos</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="process-step text-center">
                    <div class="step-number">3</div>
                    <h5 class="fw-bold mt-3">Empacamos Cuidadosamente</h5>
                    <p class="text-muted">Garantizamos que tu comida llegue perfecta y caliente</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="process-step text-center">
                    <div class="step-number">4</div>
                    <h5 class="fw-bold mt-3">Entrega Rápida</h5>
                    <p class="text-muted">Nuestro equipo de entrega lleva tu pedido directamente a ti</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================== -->
<!-- CTA FINAL -->
<!-- =========================== -->
<section class="container my-5 py-5">
    <div class="text-center">
        <h2 class="display-5 fw-bold text-danger mb-3">¿Listo para Probar Nuestra Comida?</h2>
        <p class="text-muted fs-5 mb-4">Únete a miles de clientes satisfechos que disfrutan de nuestros platillos</p>
        <a href="@Url.Action("Index", "menus")" class="btn btn-warning btn-lg px-5 py-3 rounded-pill shadow">
            <i class="bi bi-menu-button-wide"></i> Ver Nuestro Menú
        </a>
    </div>
</section>