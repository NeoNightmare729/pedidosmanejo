@model PedidosManejo.Models.ContactViewModel
@{
    ViewBag.Title = "Contáctenos - El Rincón";
}
<link href="~/Content/css/contact.css" rel="stylesheet" />
<link href="~/Content/bootstrap/bootstrap.min.css" rel="stylesheet" />

<!-- =========================== -->
<!-- HERO DE CONTACTO -->
<!-- =========================== -->
<header class="contact-hero bg-dark text-white text-center py-5">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Contáctenos</h1>
        <p class="lead fs-5 mb-4">
            Estamos aquí para atenderle. Escríbanos y nos pondremos en contacto a la brevedad.
        </p>
    </div>
</header>

<!-- =========================== -->
<!-- FORMULARIO DE CONTACTO -->
<!-- =========================== -->
<section class="content py-5">
    <div class="container">
        <div class="row align-items-stretch no-gutters contact-wrap rounded-4 overflow-hidden shadow-lg">
            <!-- Formulario -->
            <div class="col-lg-8">
                <div class="form h-100 p-5">
                    <h3 class="form-title mb-4">Envíenos un Mensaje</h3>

                    @* Mensaje de bienvenida para usuario autenticado *@
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-person-check-fill me-2"></i>
                        <strong>Hola, @ViewBag.UserName</strong> - Tus datos han sido prellenados automáticamente.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { @class = "mb-5", id = "contactForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                @Html.LabelFor(m => m.Name, new { @class = "col-form-label" })
                                @Html.TextBoxFor(m => m.Name, new
                                {
                                    @class = "form-control rounded-pill",
                                    placeholder = "Su nombre completo",
                                    @readonly = "readonly"
                                })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                @Html.LabelFor(m => m.Email, new { @class = "col-form-label" })
                                @Html.TextBoxFor(m => m.Email, new
                                {
                                    @class = "form-control rounded-pill",
                                    placeholder = "su@email.com",
                                    @readonly = "readonly"
                                })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                @Html.LabelFor(m => m.Phone, new { @class = "col-form-label" })
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control rounded-pill", placeholder = "Número de teléfono" })
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                @Html.LabelFor(m => m.Subject, new { @class = "col-form-label" })
                                @Html.DropDownListFor(m => m.Subject, new SelectList(new[]
                                {
                                    new { Value = "", Text = "Seleccionar asunto" },
                                    new { Value = "Reservas", Text = "Reservas" },
                                    new { Value = "Pedidos Especiales", Text = "Pedidos Especiales" },
                                    new { Value = "Quejas y Sugerencias", Text = "Quejas y Sugerencias" },
                                    new { Value = "Trabaje con Nosotros", Text = "Trabaje con Nosotros" },
                                    new { Value = "Otros", Text = "Otros" }
                                }, "Value", "Text"), new { @class = "form-control rounded-pill" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 form-group mb-4">
                                @Html.LabelFor(m => m.Message, new { @class = "col-form-label" })
                                @Html.TextAreaFor(m => m.Message, new { @class = "form-control rounded-3", rows = "6", placeholder = "Escriba su mensaje aquí..." })
                                @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 form-group">
                                <button type="submit" class="btn btn-primary btn-send rounded-pill py-3 px-5">
                                    <i class="bi bi-send-fill me-2"></i>Enviar Mensaje
                                </button>

                                <a href="@Url.Action("Index", "Contactos")" class="btn btn-outline-secondary rounded-pill py-3 px-4 ms-2">
                                    <i class="bi bi-list-ul me-2"></i>Ver Mis Mensajes
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Información de Contacto -->
            <div class="col-lg-4">
                <div class="contact-info h-100 p-5 text-white">
                    <h3 class="info-title mb-4">Información de Contacto</h3>
                    <p class="mb-5 opacity-75">
                        No dude en contactarnos para reservas, pedidos especiales o cualquier consulta.
                        Estamos comprometidos con su satisfacción.
                    </p>

                    <ul class="list-unstyled">
                        <li class="d-flex mb-4">
                            <div class="wrap-icon me-4">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Oficina Principal</h6>
                                <span class="opacity-75">Av. Principal #123, Centro<br>Ciudad, Estado 12345</span>
                            </div>
                        </li>

                        <li class="d-flex mb-4">
                            <div class="wrap-icon me-4">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Teléfonos</h6>
                                <span class="opacity-75">+1 (234) 567-8900<br>+1 (234) 567-8901</span>
                            </div>
                        </li>

                        <li class="d-flex mb-4">
                            <div class="wrap-icon me-4">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Correo Electrónico</h6>
                                <span class="opacity-75">info@elrincon.com<br>reservas@elrincon.com</span>
                            </div>
                        </li>

                        <li class="d-flex mb-4">
                            <div class="wrap-icon me-4">
                                <i class="bi bi-clock-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Horario de Atención</h6>
                                <span class="opacity-75">Lunes a Viernes: 8:00 AM - 10:00 PM<br>Sábados y Domingos: 9:00 AM - 11:00 PM</span>
                            </div>
                        </li>
                    </ul>

                    <div class="social-links mt-5">
                        <h6 class="mb-3">Síganos en Redes Sociales</h6>
                        <div class="d-flex gap-3">
                            <a href="#" class="social-link rounded-circle">
                                <i class="bi bi-facebook"></i>
                            </a>
                            <a href="#" class="social-link rounded-circle">
                                <i class="bi bi-instagram"></i>
                            </a>
                            <a href="#" class="social-link rounded-circle">
                                <i class="bi bi-twitter"></i>
                            </a>
                            <a href="#" class="social-link rounded-circle">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================== -->
<!-- MAPA Y UBICACIONES -->
<!-- =========================== -->
<section class="bg-light py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-danger mb-3">Nuestras Ubicaciones</h2>
            <p class="text-muted fs-5">Visítenos en cualquiera de nuestros dos restaurantes</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="location-card card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-warning text-dark rounded-top-4 py-3">
                        <h5 class="card-title mb-0 fw-bold text-center">
                            <i class="bi bi-geo-alt-fill me-2"></i>El Rincón Centro
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="map-placeholder rounded-3 bg-secondary bg-opacity-10 mb-4 d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-map text-muted" style="font-size: 3rem;"></i>
                        </div>
                        <p class="card-text mb-3">
                            <i class="bi bi-geo text-danger me-2"></i>
                            <strong>Dirección:</strong> Av. Principal #123, Centro
                        </p>
                        <p class="card-text mb-3">
                            <i class="bi bi-clock text-danger me-2"></i>
                            <strong>Horario:</strong> 7:00 AM - 11:00 PM
                        </p>
                        <p class="card-text mb-0">
                            <i class="bi bi-telephone text-danger me-2"></i>
                            <strong>Teléfono:</strong> (123) 456-7890
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="location-card card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-danger text-white rounded-top-4 py-3">
                        <h5 class="card-title mb-0 fw-bold text-center">
                            <i class="bi bi-geo-alt-fill me-2"></i>El Rincón Norte
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="map-placeholder rounded-3 bg-secondary bg-opacity-10 mb-4 d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-map text-muted" style="font-size: 3rem;"></i>
                        </div>
                        <p class="card-text mb-3">
                            <i class="bi bi-geo text-warning me-2"></i>
                            <strong>Dirección:</strong> Zona Norte #456, Residencial
                        </p>
                        <p class="card-text mb-3">
                            <i class="bi bi-clock text-warning me-2"></i>
                            <strong>Horario:</strong> 8:00 AM - 10:00 PM
                        </p>
                        <p class="card-text mb-0">
                            <i class="bi bi-telephone text-warning me-2"></i>
                            <strong>Teléfono:</strong> (123) 456-7891
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            $('#contactForm').on('submit', function (e) {
                e.preventDefault();

                var $form = $(this);
                var $submitBtn = $form.find('.btn-send');
                var $submitting = $form.find('.submitting');
                var $warning = $('#form-message-warning');
                var $success = $('#form-message-success');

                // Mostrar estado de envío
                $submitBtn.prop('disabled', true);
                $submitting.text('Enviando...').show();

                // Simular envío (reemplazar con AJAX real)
                setTimeout(function () {
                    $submitting.hide();
                    $success.fadeIn();
                    $form[0].reset();
                    $submitBtn.prop('disabled', false);

                    // Ocultar mensaje después de 5 segundos
                    setTimeout(function () {
                        $success.fadeOut();
                    }, 5000);
                }, 2000);
            });
        });
    </script>
}