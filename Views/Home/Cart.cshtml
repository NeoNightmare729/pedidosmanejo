@{
    ViewBag.Title = "Mi Carrito";
    // Validación en el servidor también
    if (!User.Identity.IsAuthenticated)
    {
        Response.Redirect("~/Account/Login?returnUrl=" + Url.Action("Cart", "Home"));
    }
}

<link href="~/Content/css/cart.css" rel="stylesheet" />

<!-- =========================== -->
<!-- HERO DEL CARRITO -->
<!-- =========================== -->
<section class="hero-section">
    <div class="container">
        <h1 class="hero-title">Mi Carrito</h1>
        <p class="hero-subtitle">
            Revisa y gestiona tus productos antes de finalizar el pedido.
        </p>
    </div>
</section>

<!-- =========================== -->
<!-- CONTENIDO DEL CARRITO -->
<!-- =========================== -->
<section class="container my-5">
    <div class="row">
        <!-- Items del carrito -->
        <div class="col-lg-8">
            @Html.AntiForgeryToken()
            <div id="emptyCart" class="text-center py-5" style="display: none;">
                <div class="empty-cart-icon">
                    <i class="bi bi-cart-x" style="font-size: 4rem; color: #6c757d;"></i>
                </div>
                <h3 class="mt-3 text-muted">Tu carrito está vacío</h3>
                <p class="text-muted">Agrega algunos productos deliciosos a tu carrito.</p>
                <a href='@Url.Action("Index", "menus")' class="btn btn-warning btn-lg mt-3">
                    <i class="bi bi-menu-button-wide"></i> Ver Menú
                </a>
            </div>

            <div id="cartItemsContainer">
                <!-- Los items del carrito se cargarán aquí via JavaScript -->
            </div>
        </div>

        <!-- Resumen del pedido -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Resumen del Pedido</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span id="subtotal">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Envío:</span>
                        <span id="shipping">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Impuestos (12%):</span>
                        <span id="tax">$0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <strong id="total">$0.00</strong>
                    </div>
                    <button class="btn btn-success w-100 mb-2" onclick="proceedToCheckout()">
                        <i class="bi bi-credit-card"></i> Proceder al Pago
                    </button>
                    <button class="btn btn-outline-danger w-100" onclick="clearCart()">
                        <i class="bi bi-trash"></i> Vaciar Carrito
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/Content/Scripts/carrito.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadCartPage();
        });
    </script>
}
