@model PedidosManejo.Models.RegisterViewModel
@{
    ViewBag.Title = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El rincón</title>
    <link href="~/Content/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/css/register.css" rel="stylesheet" />
</head>
<body>
    <div class="register-hero">
        <div class="register-container">
            <!-- Header -->
            <div class="register-header">
                <h1 class="register-title">¡Únete a nosotros!</h1>
                <p class="register-subtitle">Crea tu cuenta y disfruta de nuestras deliciosas comidas</p>
            </div>

            <!-- Body -->
            <div class="register-body">
                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "register-form", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "text-danger validation-summary-errors" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ingresa tu nombre completo" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "tu@email.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mínimo 6 caracteres" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repite tu contraseña" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", type = "tel", placeholder = "0999999999" })
                        @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Direccion, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Direccion, new { @class = "form-control", rows = 3, placeholder = "Calle principal, número de casa, referencias..." })
                        @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-register">
                        Crear mi cuenta
                    </button>
                }

                <div class="register-links">
                    <p>
                        ¿Ya tienes una cuenta?
                        @Html.ActionLink("Inicia sesión aquí", "Login", "Account", null, new { @class = "login-link" })
                    </p>
                </div>

                <div class="home-link">
                    @Html.ActionLink("← Volver al inicio", "Index", "Home", null, new { @class = "back-link" })
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>