            @Html.DisplayFor(modelItem => item.Direccion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Descripcion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Categoria)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Imagen)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.usuario.Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.RestauranteID }) |
            @Html.ActionLink("Details", "Details", new { id=item.RestauranteID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.RestauranteID })
        </td>
    </tr>
