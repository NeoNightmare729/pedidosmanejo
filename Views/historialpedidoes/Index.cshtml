@model IEnumerable<PedidosManejo.Models.historialpedido>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.EstadoAnterior)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EstadoNuevo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaCambio)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.pedido.Estado)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.usuario.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoAnterior)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoNuevo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaCambio)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.pedido.Estado)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.usuario.Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.HistorialID }) |
            @Html.ActionLink("Details", "Details", new { id=item.HistorialID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.HistorialID })
        </td>
    </tr>
}

</table>
