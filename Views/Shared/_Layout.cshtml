<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El rincón</title>
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap/bootstrap.reboot.css" rel="stylesheet" />
    <!-- Layout CSS -->
    <link href="~/Content/css/_Layout.css" rel="stylesheet" />
    <link href="~/Content/css/site.css" rel="stylesheet" />
    <!-- Modernizr -->
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
    <!-- Navbar unificada -->
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-custom sticky-top">
        <div class="container">
            @Html.ActionLink("El rincón", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Menú", "Index", "menus", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contacto", "Contact", "Home", null, new { @class = "nav-link" })</li>
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <div class="body-content">
        <div class="container">
            @RenderBody()
        </div>
    </div>

    <!-- Footer unificado -->
    <footer class="text-center">
        <div class="container">
            <p>&copy; @DateTime.Now.Year — Cadena de Restaurantes | Tus comidas en un instante</p>
            <div class="mt-3">
                <a href="#" class="me-3"><i class="bi bi-facebook"></i></a>
                <a href="#" class="me-3"><i class="bi bi-instagram"></i></a>
                <a href="#" class="me-3"><i class="bi bi-twitter"></i></a>
            </div>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="~/Scripts/jquery/jquery-3.7.0.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="~/Scripts/bootstrap/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>