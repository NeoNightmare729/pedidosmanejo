@model IEnumerable<PedidosManejo.Models.factura>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Total)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Fecha)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MetodoPago)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.pedido.Estado)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.usuario.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Total)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Fecha)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.MetodoPago)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.pedido.Estado)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.usuario.Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.FacturaID }) |
            @Html.ActionLink("Details", "Details", new { id=item.FacturaID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.FacturaID })
        </td>
    </tr>
}

</table>                                                                                 
